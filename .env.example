# ============================================================================
# BIRDIE — Configuración por Club y Entorno (staging | production)
# ============================================================================

# Identificador del club activo (corresponde a /clubs/<NEXT_PUBLIC_CLUB_ID>/config.json)
NEXT_PUBLIC_CLUB_ID=demo-club

# Entorno activo: staging | production
NEXT_PUBLIC_APP_ENV=staging

# Proyecto Supabase del Club (un proyecto por club y entorno)
NEXT_PUBLIC_SUPABASE_URL=https://your-club-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Proveedor Golf API (datos de campos, barras de salida, pares y coordenadas GPS)
GOLF_API_PROVIDER=golfapi_io
GOLF_API_BASE_URL=https://api.golfapi.io/v1
GOLF_API_KEY=your-golf-api-key

# Mapas Satelitales opcionales para vista de hoyo GPS
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Notificaciones Push (Firebase Cloud Messaging & APNs en Edge Functions)
FCM_PROJECT_ID=birdie-demo-club-staging
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.birdie.democlub
